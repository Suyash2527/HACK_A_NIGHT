# Sakshya app environment. Copy to .env.local (gitignored). Never commit real values.
# On EC2 the AWS SDK uses the instance role (IMDSv2) — never set AWS_ACCESS_KEY_ID there.

# ─── runtime
NODE_ENV=development
APP_URL=http://localhost:3000
# Shared secret CloudFront sends as X-Origin-Verify; checked in proxy.ts (unset locally = check disabled)
ORIGIN_VERIFY=

# ─── AWS (region for every client)
AWS_REGION=ap-south-1
# local dev only: named profile from `aws configure`
AWS_PROFILE=

# ─── database: Amazon RDS PostgreSQL 17 + pgvector (RLS enforced via app.user_id per transaction)
# app_user = non-owner role subject to FORCE ROW LEVEL SECURITY
DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5432/sakshya
# app_anchor = may only UPDATE anchoring columns (batch_id / merkle_proof); used by the anchor job
ANCHOR_DATABASE_URL=
# 'disable' only for local Postgres; RDS uses TLS with the RDS global CA bundle
PGSSL=

# ─── auth: Amazon Cognito (public app client, no secret, USER_PASSWORD_AUTH)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# seed script only
DEMO_PASSWORD=

# ─── evidence storage: Amazon S3 (Object Lock + versioning + SSE-KMS)
S3_EVIDENCE_BUCKET=
# local dev only (MinIO); leave unset on AWS
S3_ENDPOINT=

# ─── keys: AWS KMS + post-quantum seeds
# SIGNER=local → derive ML-DSA-65 from PQC_DSA_SEED; SIGNER=kms → KMS ML_DSA_65 key (falls back to local)
SIGNER=local
KMS_SIGN_KEY_ID=
KMS_WRAP_KEY_ID=
# Production path: seeds stored only as KMS-encrypted ciphertext (base64)
MLKEM_SEED_CT=
MLDSA_SEED_CT=
# Dev path: raw base64 seeds (ML-KEM 64 bytes = 88 chars, ML-DSA 32 bytes = 44 chars).
# Generate: node -e "const c=require('crypto');console.log(c.randomBytes(64).toString('base64'));console.log(c.randomBytes(32).toString('base64'))"
# LOSING PQC_KEM_SEED MAKES EVERY DOCUMENT UNDECRYPTABLE — back it up.
PQC_KEM_SEED=
PQC_DSA_SEED=
# Server-side salt for pseudonymous on-chain actor hashes (sha256(userId || salt))
ACTOR_HASH_SALT=

# ─── blockchain (see contracts/config/networks.ts): local | amoy | polygon
QS_CHAIN=local
LOCAL_RPC_URL=http://127.0.0.1:8545
AMOY_RPC_URL=https://polygon-amoy.drpc.org
QS_REGISTRY_ADDRESS=
QS_REGISTRY_DEPLOY_BLOCK=
# backend signer holding RECORDER_ROLE + VERIFIER_ROLE on the registry (testnet-only key)
QS_CHAIN_SIGNER_PRIVATE_KEY=
# mainnet requires QS_ALLOW_MAINNET=I_UNDERSTAND_REAL_FUNDS and NODE_ENV=production
QS_ALLOW_MAINNET=

# ─── bonus: Amazon Bedrock RAG (assistant disabled when empty)
BEDROCK_REGION=ap-south-1
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=
