# Copy to contracts/.env (gitignored). Hardhat 3 does not read .env itself — hardhat.config.ts loads it.
# Real shell env vars override this file. Never commit real values.

# ---- network selection for the backend (config/networks.ts): local | sepolia | amoy | polygon
QS_CHAIN=sepolia

# ---- RPC URLs (defaults in config/networks.ts are used when unset)
LOCAL_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AMOY_RPC_URL=https://polygon-amoy.drpc.org
POLYGON_RPC_URL=https://polygon.drpc.org

# ---- deployer keys: a DEDICATED testnet-only key. Create one with `npm run wallet:new`.
# Never reuse a wallet that holds real funds. Hardhat's public dev keys are rejected off-local.
SEPOLIA_DEPLOYER_PRIVATE_KEY=
AMOY_DEPLOYER_PRIVATE_KEY=
# Mainnet is refused unless BOTH QS_ALLOW_MAINNET=I_UNDERSTAND_REAL_FUNDS and NODE_ENV=production are set.
POLYGON_DEPLOYER_PRIVATE_KEY=
QS_ALLOW_MAINNET=

# ---- optional role separation at deploy time (default: deployer address)
QS_ADMIN_ADDRESS=
QS_RECORDER_ADDRESS=
QS_VERIFIER_ADDRESS=

# ---- source verification on Polygonscan (Etherscan API v2 key: one key for all chains)
ETHERSCAN_API_KEY=

# ---- event indexer: eth_getLogs block window (free RPCs cap ranges)
INDEX_BLOCK_RANGE=1000
